# DeepSeek API Configuration for IARC XII Chatbot
# Dapatkan API Key di https://platform.deepseek.com/
DEEPSEEK_API_KEY=your_deepseek_api_key_here

# Base URL (default: https://api.deepseek.com)
DEEPSEEK_BASE_URL=https://api.deepseek.com

# DeepSeek Model (e.g. deepseek-chat or your preferred flash variant)
DEEPSEEK_MODEL=deepseek-chat
